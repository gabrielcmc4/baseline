rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only the sessions stored under their own user id.
    match /users/{uid}/sessions/{sid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'date', 'savedAt', 'mode', 'name', 'duration', 'stats', 'meta', 'shots', 'thumb'])
        && request.resource.data.date is string && request.resource.data.date.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.mode in ['coach', 'serve', 'match']
        && request.resource.data.shots is list && request.resource.data.shots.size() <= 3000
        && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 150000;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
